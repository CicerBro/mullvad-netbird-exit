# Safe template for local deployment settings. Copy it to .env; .env is ignored by Git.
# Replace every CHANGEME value before running ./build.sh.
HOSTNAME=mullvad-exit
SSH_PUBLIC_KEY="CHANGEME"

# Make this a one-off NetBird setup key when possible.
NETBIRD_SETUP_KEY=CHANGEME
NETBIRD_OVERLAY_CIDR=100.115.0.0/16
NETBIRD_WG_PORT=51820

MULLVAD_ACCOUNT=CHANGEME
MULLVAD_COUNTRY=de
MULLVAD_CITY=ber
